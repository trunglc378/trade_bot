{
    "vn_policy": {
        "research": {
            "mode": "advisory",
            "providers": {
                "gemini": {
                    "model": "gemini-pro-latest",
                    "google_search": true,
                    "min_source_domains": 2,
                    "source_domains": [
                        "binance.com",
                        "okx.com",
                        "ethereum.org",
                        "solana.com",
                        "federalreserve.gov",
                        "sec.gov",
                        "reuters.com",
                        "coindesk.com"
                    ]
                }
            },
            "min_ai_votes": 1,
            "min_ai_confidence": 0.75,
            "ai_control": {
                "enabled": false,
                "only_in_session": true,
                "min_interval_seconds": 1800,
                "max_requests_per_hour": 2,
                "max_requests_per_day": 20,
                "cache_ttl_seconds": 600,
                "max_candidates": 3,
                "max_input_chars": 12000,
                "backoff_seconds": 900,
                "max_backoff_seconds": 21600
            }
        }
    }
}
