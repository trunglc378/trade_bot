# ============================================================================
# BIẾN MÔI TRƯỜNG VẬN HÀNH 24/7 TRÊN ORACLE CLOUD FREE TIER (KHÔNG COMMIT LÊN GIT)
# ============================================================================

# 1. Khóa API Trí tuệ Nhân tạo (ChatGPT Pro / OpenAI Platform & Google Gemini Pro)
OPENAI_API_KEY=
GEMINI_API_KEY=

# 2. Chu kỳ quét thị trường của AI Research Worker (giây, mặc định 300s = 5 phút)
RESEARCH_INTERVAL_SECONDS=300

# 3. Địa chỉ IP mạng riêng Tailscale VPN của máy chủ Oracle Cloud (VD: 100.88.99.101)
# Để mặc định 127.0.0.1 khi chạy thử cục bộ trên máy cá nhân.
TAILSCALE_IP=127.0.0.1

# 4. Tệp cấu hình bí mật và Cơ sở dữ liệu cho từng sàn (Tự động tạo bởi setup_accounts.py)
BINANCE_PRIVATE_CONFIG=config.private.binance.json
BINANCE_DB_FILE=tradesv3.binance.dryrun.sqlite

OKX_PRIVATE_CONFIG=config.private.okx.json
OKX_DB_FILE=tradesv3.okx.dryrun.sqlite
