<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Thanh tiêu đề & Nút cấu hình máy chủ VPS/Tailscale -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🤖 FreqBot VN Remote"
                android:textColor="#F8FAFC"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCauHinhMayChu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#334155"
                android:text="⚙️ Máy chủ"
                android:textAllCaps="false"
                android:textColor="#F8FAFC"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDiaChiMayChu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="🌐 Máy chủ: http://10.0.2.2:8080/"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <!-- Thẻ 1: Trạng thái Giáp Bảo Vệ Rủi Ro (Protections) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <TextView
                android:id="@+id/tvTrangThaiRuiRo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:padding="14dp"
                android:text="🔄 Đang kiểm tra trạng thái Giáp bảo vệ rủi ro..."
                android:textColor="#34D399"
                android:textSize="14sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>

        <!-- Thẻ 2: Tổng quan Hiệu suất & Lợi nhuận -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <TextView
                android:id="@+id/tvTongQuan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="5dp"
                android:padding="14dp"
                android:text="📊 TỔNG QUAN HIỆU SUẤT GIAO DỊCH\nĐang tải dữ liệu lợi nhuận từ Freqtrade..."
                android:textColor="#E2E8F0"
                android:textSize="14sp" />
        </androidx.cardview.widget.CardView>

        <!-- Thẻ 3: Số dư Tài khoản USDT -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <TextView
                android:id="@+id/tvSoDuTaiKhoan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="5dp"
                android:padding="14dp"
                android:text="💼 SỐ DƯ TÀI KHOẢN (USDT)\nĐang tải số dư..."
                android:textColor="#38BDF8"
                android:textSize="14sp" />
        </androidx.cardview.widget.CardView>

        <!-- Thẻ 4: Khung Giờ Vàng (03:00-04:00 VN) & Đề Xuất Coin Đa Nguồn AI -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <TextView
                android:id="@+id/tvCoVanAi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="5dp"
                android:padding="14dp"
                android:text="NGHIÊN CỨU THỊ TRƯỜNG &amp; AI\nChờ báo cáo; đồng bộ qua mock nếu máy chủ hỗ trợ."
                android:textColor="#FDE68A"
                android:textSize="13sp" />
        </androidx.cardview.widget.CardView>

        <!-- Cụm Nút Điều Khiển Khẩn Cấp (Tạm dừng mua / Bật lại mua / Bán khẩn cấp) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnTamDungMua"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#D97706"
                android:text="⏸️ Tạm dừng Mua"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnBatLaiMua"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="#059669"
                android:text="▶️ Bật lại Mua"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnBanKhanCap"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#DC2626"
            android:text="🚨 CẮT LỖ / BÁN KHẨN CẤP TOÀN BỘ (PANIC SELL)"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Tiêu đề Danh sách Lệnh Đang Mở -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="📈 DANH SÁCH LỆNH ĐANG MỞ (CẬP NHẬT 5 GIÂY/LẦN)"
            android:textColor="#F8FAFC"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTrongDanhSach"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:padding="16dp"
            android:text="Hiện không có lệnh nào đang mở (100% vốn đang ở USDT)."
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDanhSachLenh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</ScrollView>
