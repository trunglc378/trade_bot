<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#1E293B"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvCapCoinVaMa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="[#101] BTC/USDT • Vốn: 250.0 USDT"
                android:textColor="#F8FAFC"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDongLenhDon"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:backgroundTint="#EF4444"
                android:text="@string/btn_close_single_trade"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBadgeLaiLo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="🟢 ĐANG LÃI: +2.09% (+5.22 USDT)"
            android:textColor="#10B981"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvChiTietGia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="• Giá mua vào: 68000.0000 USDT | Giá hiện tại: 69420.0000 USDT"
            android:textColor="#CBD5E1"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvMocCatLoVaTag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:text="• Mốc cắt lỗ cứng (Stop-Loss): 65960.0000 USDT\n• Tín hiệu: Xu hướng tăng EMA20 > EMA50 > EMA200 + RSI(14) thuận lợi"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
